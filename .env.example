# ─────────────────────────────────────────────────────────────────────────────
# Synthetic Solutions – Inventory Edition  ·  Environment Variables
# Copy this file to .env and fill in the values before starting the server.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
#
# Docker Compose: leave this commented out.  Compose constructs DATABASE_URL
# automatically using the postgres service hostname so containers can reach each
# other.  Setting it here would forward a localhost URL into the container where
# localhost resolves to the container itself, not the postgres service.
#
# Direct / non-Docker use: uncomment and set to your PostgreSQL instance.
#   DATABASE_URL=postgresql://inventory:changeme@localhost:5432/inventory

# ── Auth / Encryption ────────────────────────────────────────────────────────
# Random secret used to sign JWTs and encrypt AI API keys at rest (AES-256-GCM).
# MUST be at least 32 characters. Changing this invalidates all active sessions
# and makes previously-stored AI keys unreadable.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# ── API Server ───────────────────────────────────────────────────────────────
# Port the Express server binds to.
PORT=8080

# Set to "production" on a live server, "development" for local dev
# (enables pretty-printed pino logs in development).
NODE_ENV=production

# Comma-separated list of allowed HTTPS browser origins. Required by Docker
# Compose in production. Native Expo clients do not require CORS, but Compose
# still requires a value; use the HTTPS origin that will host the browser app.
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=

# ── AI (optional) ────────────────────────────────────────────────────────────
# xAI Grok API key — required only if the AI chat / report features are used.
# Admins can also store the key encrypted in the database via the Settings
# screen; this env var is the fallback if the stored key cannot be decrypted.
# Leave blank to disable AI features.
XAI_API_KEY=

# ── First-run admin seed (optional — used by the seed Docker Compose service) ─
# Only needed when seeding the first admin account on a fresh deploy.
# Run: ADMIN_PIN=1234 ADMIN_NAME=Admin docker compose --profile seed run --rm seed
# The seed command is idempotent — safe to run again; it exits immediately if
# an admin account already exists.
ADMIN_NAME=Admin
ADMIN_PIN=

# ── Docker Compose (postgres service only) ───────────────────────────────────
# These are used by the postgres container in docker-compose.yml.
# Compose uses them to build the container-to-container DATABASE_URL.
POSTGRES_USER=inventory
POSTGRES_PASSWORD=
POSTGRES_DB=inventory

# Database backups are run from the host with the Compose commands documented
# in README.md. The automated Ubuntu schedule uses the root-only
# /etc/inventory-backup.env file and restic; keep off-server credentials out of
# this file and out of Git.
