[Unit]
Description=Check inventory backup freshness
Wants=network-online.target
After=network-online.target
OnFailure=inventory-backup-alert@inventory-backup-check.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/inventory-backup.env
ExecStart=/usr/local/libexec/inventory-backup-check
RuntimeDirectory=inventory-backup
RuntimeDirectoryMode=0700
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal