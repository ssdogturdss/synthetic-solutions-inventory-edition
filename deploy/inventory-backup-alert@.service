[Unit]
Description=Alert for failed inventory backup unit
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/inventory-backup.env
ExecStart=/usr/local/libexec/inventory-backup-alert %i
TimeoutStartSec=1min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal