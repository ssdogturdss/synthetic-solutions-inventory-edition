# Copy to /etc/inventory-backup.env on the Ubuntu host, then:
#   chown root:root /etc/inventory-backup.env
#   chmod 0600 /etc/inventory-backup.env
#
# This file is read by systemd, not by Docker Compose. Do not put these
# settings in the application's .env file.

COMPOSE_PROJECT_DIR=/opt/inventory
BACKUP_DIR=/var/lib/inventory-backups
# The API reads only last-run, last-check, and last-restore-drill metadata
# from this directory.
BACKUP_STATUS_DIR=/var/lib/inventory-backups
RESTIC_PASSWORD_FILE=/etc/inventory-backup-password
MAX_BACKUP_AGE_HOURS=26

# Use the business-approved off-server destination. restic encrypts repository
# contents before upload. Example:
# RESTIC_REPOSITORY=s3:https://s3.example.com/inventory-backups
RESTIC_REPOSITORY=REPLACE_WITH_APPROVED_RESTIC_REPOSITORY

# Set the provider's credentials here when the selected repository requires
# them. Keep this file root-readable only; never copy these values to Git or
# the application's .env file.
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME
# AWS_DEFAULT_REGION=REPLACE_ME

# Optional alert destination. The journal alert is always emitted. If set, the
# endpoint receives only a plain-text failure notice, never credentials or dump
# contents. Keep this value in the root-only environment file.
# ALERT_WEBHOOK_URL=https://alerts.example.com/inventory

# Optional authenticated backup push callback. Set the same random token as
# the API server's BACKUP_PUSH_TOKEN secret. Callback bodies contain only the
# backup issue key and whether it is currently alerting or healthy.
# Generate the token with: openssl rand -hex 32
# BACKUP_PUSH_URL=https://inventory.example.com/api/backup/events
# BACKUP_PUSH_TOKEN=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_TOKEN

# Optional overrides. The defaults implement daily 14, weekly 8, monthly 12.
# LOCAL_RETENTION_DAYS=14
# RESTIC_KEEP_DAILY=14
# RESTIC_KEEP_WEEKLY=8
# RESTIC_KEEP_MONTHLY=12